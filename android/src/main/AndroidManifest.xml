<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- iroh reads the system resolver through ConnectivityService so it can use
         the network's own DNS rather than a hardcoded fallback. Declared here
         rather than in the example so every consuming app inherits it: without
         it the lookup throws, iroh falls back to Google's resolvers, and
         discovery quietly degrades. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- mDNS LAN discovery (the `mdns` Cargo feature, Android-only) speaks DNS-SD
         over multicast. Android drops inbound multicast Wi-Fi packets unless an
         app holds a MulticastLock, and taking that lock requires this permission.
         The library owns the lock (see the Rust `multicast_lock` module) and so
         ships the permission here, in its own manifest, rather than making every
         consuming app declare it. Harmless when mDNS is unused. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

</manifest>
